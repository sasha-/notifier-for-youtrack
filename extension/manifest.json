{
  "manifest_version": 3,
  "name": "Notifier for YouTrack",
  "version": "1.5.0",
  "description": "Desktop notifications for your YouTrack notification center, with Mark read and Watch buttons. Not affiliated with JetBrains.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Notifier for YouTrack",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
